{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://tokun.local/schemas/signal.schema.json",
  "title":"Tokun X research signal",
  "type":"object",
  "required":["contract_version","signal_id","event_id","source","published_at","captured_at","industry_event","user_problem","target_audience","evidence_status","dedup_key","access_scope"],
  "properties":{
    "contract_version":{"const":"1.0.0"},
    "signal_id":{"type":"string","pattern":"^sig_[a-z0-9_-]+$"},
    "event_id":{"type":"string","minLength":3},
    "source":{
      "type":"object",
      "required":["url","author_handle","source_type"],
      "properties":{
        "url":{"type":"string","pattern":"^https://x\\.com/"},
        "author_handle":{"type":"string","minLength":1},
        "source_type":{"enum":["post","comment","thread"]},
        "parent_url":{"type":["string","null"]}
      },
      "additionalProperties":true
    },
    "published_at":{"type":"string","format":"date-time"},
    "captured_at":{"type":"string","format":"date-time"},
    "industry_event":{"type":"string","minLength":3},
    "user_problem":{"type":"string","minLength":3},
    "target_audience":{"type":"array","minItems":1,"items":{"type":"string"}},
    "evidence_status":{"enum":["verified_source_observed","partially_observed","unverified","unknown"]},
    "dedup_key":{"type":"string","minLength":3},
    "access_scope":{
      "type":"object",
      "required":["comment_sort","sampled_comments","full_thread_coverage","limitations"],
      "properties":{
        "comment_sort":{"type":["string","null"]},
        "sampled_comments":{"type":"integer","minimum":0},
        "full_thread_coverage":{"type":"boolean"},
        "limitations":{"type":"array","items":{"type":"string"}}
      }
    },
    "competitor_excluded":{"type":"boolean"},
    "handoff":{"type":"object"}
  },
  "additionalProperties":true
}

