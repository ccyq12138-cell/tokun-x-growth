{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://tokun.local/schemas/run-state.schema.json",
  "type":"object",
  "required":["contract_version","run_id","stage_id","task_id","status","input_artifact_ids","checkpoint","updated_at"],
  "properties":{
    "contract_version":{"const":"1.0.0"},
    "run_id":{"type":"string"},
    "stage_id":{"pattern":"^stage-[1-8]$"},
    "task_id":{"type":"string"},
    "status":{"enum":["planned","running","completed","failed","skipped","blocked_pending_approval","not_implemented","unknown"]},
    "input_artifact_ids":{"type":"array","items":{"type":"string"}},
    "output_artifact_ids":{"type":"array","items":{"type":"string"}},
    "checkpoint":{"type":"string"},
    "error":{"type":["object","null"]},
    "updated_at":{"type":"string","format":"date-time"}
  },
  "additionalProperties":true
}

